# ============================================================================
# SUPABASE
# ============================================================================
# Dal dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service Role Key: SOLO lato server (cron e scritture admin). Mai esporla
# al browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ============================================================================
# CRON
# ============================================================================
# Protegge le rotte /api/cron/*. Vercel Cron invia l'intestazione
# `Authorization: Bearer $CRON_SECRET`; il job pg_cron su Supabase deve
# usare lo stesso valore.
CRON_SECRET=genera-una-stringa-random-lunga

# ============================================================================
# TELEGRAM
# ============================================================================
# Non si configura qui: token del bot e chat id sono per utente, si
# inseriscono dalla sezione Settings dell'app e finiscono nella tabella
# user_settings.
